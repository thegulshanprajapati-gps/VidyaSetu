datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum UserRole {
  SUPER_ADMIN
  COLLEGE_ADMIN
  MODERATOR
  CANDIDATE
}

enum AccountStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

enum InstitutionType {
  POLYTECHNIC
  ENGINEERING
  DEGREE
  UNIVERSITY
  MEDICAL
  OTHER
}

enum OwnershipType {
  GOVERNMENT
  PRIVATE
  AIDED
}

enum CollegeVerificationStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  CHANGES_REQUESTED
  SUSPENDED
}

enum JobCategory {
  TEACHING
  NON_TEACHING
  TECHNICAL
  ADMINISTRATIVE
}

enum EmploymentType {
  PERMANENT
  CONTRACTUAL
  GUEST_FACULTY
  TEMPORARY
  PART_TIME
}

enum VacancyStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  PUBLISHED
  CHANGES_REQUESTED
  REJECTED
  CLOSED
  ARCHIVED
}

enum ApplicationMode {
  ONLINE
  OFFLINE
  WALK_IN
  EMAIL
}

enum NewsType {
  NEWS
  NOTICE
  CIRCULAR
}

enum NewsStatus {
  DRAFT
  SUBMITTED
  PUBLISHED
  ARCHIVED
}

model User {
  id              String        @id @default(cuid())
  name            String
  email           String        @unique
  passwordHash    String
  role            UserRole      @default(COLLEGE_ADMIN)
  collegeId       String?
  college         College?      @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  status          AccountStatus @default(PENDING)
  designation     String?
  phone           String?
  isEmailVerified Boolean       @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  vacanciesCreated Vacancy[] @relation("CreatedVacancies")
  vacanciesUpdated Vacancy[] @relation("UpdatedVacancies")
  newsCreated      News[]    @relation("AuthoredNews")
  auditLogs        AuditLog[]

  @@index([email])
  @@index([collegeId, role])
}

model College {
  id                     String                    @id @default(cuid())
  name                   String
  slug                   String                    @unique
  institutionType        InstitutionType
  ownershipType          OwnershipType
  state                  String                    @default("Bihar")
  district               String
  city                   String
  address                String
  officialWebsite        String?
  officialEmail          String
  officialPhone          String
  establishmentYear      Int?
  affiliationInfo        String?
  description            String?
  logoUrl                String?
  verificationStatus     CollegeVerificationStatus @default(PENDING)
  authorizationLetterUrl String?
  domainProofUrl         String?
  additionalNotes        String?
  moderatorNotes         String?
  verifiedAt             DateTime?
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt

  users     User[]
  vacancies Vacancy[]
  news      News[]
  auditLogs AuditLog[]

  @@index([slug])
  @@index([verificationStatus, state, district])
  @@index([institutionType, ownershipType])
}

model Vacancy {
  id                   String          @id @default(cuid())
  collegeId            String
  college              College         @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  title                String
  slug                 String          @unique
  department           String
  postName             String
  numberOfPosts        Int?            @default(1)
  jobCategory          JobCategory
  employmentType       EmploymentType
  qualification        String
  experience           String?
  ageCriteria          String?
  salary               String?
  applicationFee       String?
  applicationMode      ApplicationMode @default(ONLINE)
  notificationDate     DateTime
  applicationOpenDate  DateTime
  applicationCloseDate DateTime
  interviewDate        DateTime?
  descriptionHtml      String
  notificationPdfUrl   String?
  officialApplyUrl     String?
  district             String
  state                String          @default("Bihar")
  status               VacancyStatus   @default(DRAFT)
  moderatorRemarks     String?
  submittedAt          DateTime?
  publishedAt          DateTime?

  createdById String
  createdBy   User     @relation("CreatedVacancies", fields: [createdById], references: [id])
  updatedById String
  updatedBy   User     @relation("UpdatedVacancies", fields: [updatedById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, applicationCloseDate])
  @@index([status, state, district])
  @@index([status, jobCategory, employmentType])
}

model News {
  id            String     @id @default(cuid())
  collegeId     String?
  college       College?   @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  contentType   NewsType   @default(NOTICE)
  title         String
  slug          String     @unique
  summary       String
  bodyHtml      String
  category      String
  attachmentUrl String?
  isImportant   Boolean    @default(false)
  status        NewsStatus @default(DRAFT)
  publishedAt   DateTime?

  authorId String
  author   User   @relation("AuthoredNews", fields: [authorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishedAt])
  @@index([collegeId, contentType])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  actorEmail String
  actorRole  String
  action     String
  targetType String
  targetId   String
  collegeId  String?
  college    College? @relation(fields: [collegeId], references: [id], onDelete: SetNull)
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([collegeId, createdAt])
}

model CommunityPost {
  id          String   @id @default(cuid())
  authorName  String
  authorEmail String?
  authorRole  String   @default("CANDIDATE")
  title       String
  content     String
  category    String   @default("GENERAL")
  likes       Int      @default(0)
  isFlagged   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([category, createdAt])
}

